source $ZSHPATH/.function

function al(){
    if [ "$1" = "help" ]; then
	cat $ZSHPATH/.alias | tail -n +19 | sed 's/alias/  /g'
    elif [ "$1" = "open" ]; then
	vi $ZSHPATH/.alias
    elif [ "$1" = "save" ]; then
        DATE=$(date +%Y/%m/%d-%H:%M:%S)
        git add --all
        git commit -m "update on $DATE"
        echo git push origin master
	exec $SHELL
    else
        al help
    fi
}


# open / save / [up]hp / new
# alia-----------------------------------------------------------------------
alias activate='source ./env/bin/activate';
alias pip-makeList='pip freeze > ./requirements.txt';
alias prp="pipenv run python"
alias pp='ping 8.8.8.8';                   alias pd='ping google.com';
alias cls='clear';                         alias lll='ls -all';
alias rmdir=_rmdir;                        alias rmdiri=_rmdiri;

# git------------------------------------------------------------------------
alias gs='git status';                     alias gcl=_gcl;
alias gp='git push';                       alias gl='git log';
alias gpp='git pull';                      alias gll='git log --oneline';
alias ga='git add';                        alias gk=_gk;
alias gaa='git add --all';                 alias gb=_gb;
alias gc='git commit -a';                  alias gmg=_gmg;
alias gm='git commit -m';                  alias gnew=_gnew;
alias gz='git cz';                         alias gacp=_gacp;
alias gcp=_gcp;                            alias gac=_gac;

