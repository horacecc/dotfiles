# No shebang: writeShellApplication adds one
# Runs the real op with the service account token from the Keychain item mapped
# to this directory in ~/.config/op-services, or named by OP_KEYCHAIN_SERVICE

# Nix fills in the store path, so no other op in PATH can be handed the token
real=@op@

service=${OP_KEYCHAIN_SERVICE-}
services_file=${XDG_CONFIG_HOME:-$HOME/.config}/op-services
if [ -z "$service" ] && [ -r "$services_file" ]; then
	here=$(pwd -P)
	best=0
	while IFS=, read -r dir item extra; do
		case $dir in '' | '#'*) continue ;; esac
		if [ -z "$item" ] || [ -n "$extra" ]; then
			# Fail closed, as for an unreadable item below
			echo "op: $services_file: expected <directory>,<Keychain item>: $dir,$item${extra:+,$extra}" >&2
			exit 1
		fi
		## The file has a literal ~; expand it ourselves
		# shellcheck disable=SC2088
		case $dir in "~" | "~/"*) dir=$HOME${dir#"~"} ;; esac
		if ! root=$(cd "$dir" 2>/dev/null && pwd -P); then
			# A typo in the path would otherwise drop the mapping without a word
			echo "op: $services_file: not a directory: $dir" >&2
			exit 1
		fi
		case $here in
			"$root" | "$root"/*)
				if [ ${#root} -gt "$best" ]; then
					service=$item
					best=${#root}
				fi
				;;
		esac
	done < "$services_file"
fi

token=
if [ -n "$service" ]; then
	if ! token=$(security find-generic-password -s "$service" -w 2>/dev/null) || [ -z "$token" ]; then
		# Fail closed: do not fall back to another account with wider access
		echo "op: could not read the token from Keychain item '$service'" >&2
		exit 1
	fi
fi

## `op run ... -- cmd`: cmd never sees the token. Global flags such as --account
## can come before run, and op's flags aren't parsed here, so any run before the
## first -- counts
run=
for arg do
	case $arg in
		--) break ;;
		run) run=1 ;;
	esac
done
if [ -n "$run" ]; then
	seen=
	for arg do
		shift
		if [ -z "$seen" ] && [ "$arg" = -- ]; then
			seen=1
			set -- "$@" -- env -u OP_SERVICE_ACCOUNT_TOKEN
		else
			set -- "$@" "$arg"
		fi
	done
	if [ -z "$seen" ] && [ -n "$token" ]; then
		# Fail closed: without --, the command could be handed the token
		echo "op: put -- before the command that op run starts" >&2
		exit 1
	fi
fi

if [ -n "$token" ]; then
	OP_SERVICE_ACCOUNT_TOKEN=$token exec "$real" "$@"
else
	exec "$real" "$@"
fi
