# Packaged by home-manager with writeShellApplication, which adds the shebang
# and checks this file with shellcheck at build time. Test with `sh <this file>`.
# Usage: `gitignore Go` writes GitHub's Go template to ./.gitignore
# Names are case-sensitive, as in https://github.com/github/gitignore
# (subfolders too, e.g. `gitignore Global/macOS`)

if [ $# -ne 1 ]; then
	echo "Usage: gitignore <Name>  (e.g. gitignore Go)" >&2
	exit 1
fi

## Template names only: no "..", no leading "/", no URL syntax
case $1 in
	*..* | /* | *[!A-Za-z0-9._+/-]*)
		echo "gitignore: not a template name: $1" >&2
		exit 1
		;;
esac

if [ -e .gitignore ]; then
	echo ".gitignore already exists; not overwriting it." >&2
	exit 1
fi

## Download first, so a failed request never leaves a partial .gitignore
if ! res=$(curl -fsSL "https://raw.githubusercontent.com/github/gitignore/main/$1.gitignore"); then
	echo "Could not download the $1 template (unknown name or network error)." >&2
	exit 1
fi

printf '%s\n' "$res" > .gitignore
echo "Wrote $1's .gitignore."
