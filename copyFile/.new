function new(){
    if [ "$1" = "help" ]; then
        echo "    editorconfig [gnName='.editorconfig']   add a .editorconfig"
        echo "    gitignore [gnName='.gitignore']         add a .gitignore"
        echo "    gitkeep                                 add a .gitkeep"
        echo "    txt [txtName='new']                     make a txtFile"
        echo "    readme                                  make a README.md"
        echo "    dir [dirName='new']                     make a directory"
        echo "    java [javaName='main']                  make a javaFile"
        echo "    env                                     make a python virtualenv"
        echo ""
        echo "  from $ZSHPATH/copyFile/"
    elif [ "$1" = "editorconfig" ]; then
        if [ "$2" != "" ]; then
            cp $ZSHPATH/copyFile/.editorconfig.orig ./"$2"
        else
            cp $ZSHPATH/copyFile/.editorconfig.orig ./.editorconfig
        fi
    elif [ "$1" = "gitignore" ]; then
        if [ "$2" != "" ]; then
            cp $ZSHPATH/copyFile/.gitignore.orig ./"$2"
        else
            cp $ZSHPATH/copyFile/.gitignore.orig ./.gitignore
        fi
    elif [ "$1" = "gitkeep" ]; then
        touch .gitkeep
    elif [ "$1" = "txt" ]; then
        if [ "$2" != "" ]; then
            cp $ZSHPATH/copyFile/new.txt ./"$2".txt
        else
            cp $ZSHPATH/copyFile/new.txt ./new.txt
        fi
    elif [ "$1" = "dir" ]; then
        if [ "$2" != "" ]; then
            mkdir "$2"
        else
            mkdir new
        fi
    elif [ "$1" = "java" ]; then
        if [ "$2" != "" ]; then
            cp $ZSHPATH/copyFile/Main.java ./"$2".java
        else
            cp $ZSHPATH/copyFile/Main.java ./Main.java
        fi
    elif [ "$1" = "readme" ]; then
        cp $ZSHPATH/copyFile/README.md ./README.md
    elif [ "$1" = "env" ]; then
        if [ "$2" != "" ]; then
            python -m venv "$2"
        else
            python -m venv env
        fi
    else
        new help
    fi
}

