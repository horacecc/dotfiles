# Global gitignore (core.excludesfile), applied to every repository.
# Only list files that no project should ever commit. Rules here silently
# hide new files everywhere; check with `git check-ignore -v <path>`.

# macOS folder view settings
.DS_Store

# macOS resource forks on non-HFS volumes
._*

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# Windows folder view settings and thumbnail cache
Desktop.ini
Thumbs.db

# Shell history (may contain secrets typed on the command line)
.zsh_history

# Compiled files and caches
*.pyc
.zshrc.zwc

# Logs and local databases
*.log
*.sqlite3

# JetBrains IDE settings
.idea/
